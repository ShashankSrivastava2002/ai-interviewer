# =====================================================================
# AI Voice Interviewer — settings
# Copy this file to backend/.env and fill in what you need.
# Keys stay on the server; the browser never sees them.
# =====================================================================

# ---------------------------------------------------------------------
# LLM (asks the questions + writes the feedback)
# ---------------------------------------------------------------------
# openai     = any OpenAI-compatible server: OpenAI, Ollama, Groq, vLLM, LM Studio, OpenRouter …
# anthropic  = Claude
# gemini     = Google Gemini
LLM_PROVIDER=openai

# Leave empty for a sensible default per provider:
#   openai -> gpt-4.1-mini   anthropic -> claude-sonnet-5-5   gemini -> gemini-2.5-flash
# Examples: llama3.1:8b (Ollama), llama-3.3-70b-versatile (Groq)
LLM_MODEL=

# Only for OpenAI-compatible servers other than OpenAI itself:
#   Ollama: http://localhost:11434/v1     (no key needed)
#   Groq:   https://api.groq.com/openai/v1
#   vLLM:   http://localhost:8001/v1
LLM_BASE_URL=

# Key for an OpenAI-compatible server (Groq, OpenRouter …). Falls back to OPENAI_API_KEY.
LLM_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Seconds to wait for the LLM (feedback reports can take a while)
LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------
# Speech-to-text (must be VERBATIM — keeps um/uh, stammers, repetitions)
# ---------------------------------------------------------------------
# local       = runs on your machine (CrisperWhisper 2.0 or faster-whisper)
# deepgram    = Deepgram nova-3 with filler_words=true
# assemblyai  = AssemblyAI with disfluencies=true
# openai      = OpenAI /audio/transcriptions (verbatim prompt; may still drop some fillers)
STT_PROVIDER=local

# Local engine: crisperwhisper (recommended for verbatim) | faster-whisper
LOCAL_STT_ENGINE=crisperwhisper

# CrisperWhisper 2.0 size: large (best) | turbo (fast) | medium | small (lightest)
# Weights download from Hugging Face on first run (nyralabs/CrisperWhisper2.0_<size>).
# License: nyra health Non-Commercial Research License — personal/research use only.
CRISPERWHISPER_MODEL=large

# transformers (works everywhere) | ct2 (fastest; NVIDIA GPU on Linux) | auto
CRISPERWHISPER_BACKEND=transformers

# faster-whisper model (only when LOCAL_STT_ENGINE=faster-whisper): large-v3, medium.en, small.en …
WHISPER_MODEL=large-v3

# auto (GPU if available, else CPU) | cpu | cuda
DEVICE=auto

# Leave empty for automatic: float16 on GPU, int8 on CPU (CTranslate2), float32 on CPU (PyTorch)
COMPUTE_TYPE=

# Language spoken in the interview
STT_LANGUAGE=en

DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# OpenAI transcription (uses OPENAI_API_KEY)
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
# Where recordings and the SQLite database are stored (default: ./data)
# DATA_DIR=./data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
